# ==============================================================
# PLANTILLA DE VARIABLES DE ENTORNO (EJEMPLO)
# ==============================================================
# Copia este archivo con el nombre '.env' y personaliza tus contraseñas:
#   copy .env.example .env

# 1. Base de Datos (PostgreSQL)
POSTGRES_DB=salon_gestion_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_clave_segura_aqui
POSTGRES_PORT=5432
# 127.0.0.1 = la base de datos sólo es accesible desde esta PC (recomendado)
POSTGRES_BIND=127.0.0.1

# 2. Backend (Spring Boot)
BACKEND_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Clave del usuario admin@salon.com SOLO al crearse por primera vez (bases nuevas)
SEED_ADMIN_PASSWORD=cambia_esta_clave

# 3. Frontend (Angular + Nginx)
FRONTEND_PORT=80
FRONTEND_ALT_PORT=4200
